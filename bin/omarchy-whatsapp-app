#!/bin/bash
# Launches the custom Omarchy WhatsApp standalone client window via Quickshell.

source "$(dirname "$(readlink -f "$0")")/_common.sh"

APP_QML="$WA_ROOT/AppWindow.qml"

if ! command -v quickshell >/dev/null 2>&1; then
  wa_die "quickshell is required to launch the standalone client window."
fi

case "$1" in
--toggle)
  if pgrep -f "quickshell.*AppWindow\.qml" >/dev/null 2>&1; then
    pkill -f "quickshell.*AppWindow\.qml"
    exit 0
  fi
  ;;
--hide | --quit)
  pkill -f "quickshell.*AppWindow\.qml"
  exit 0
  ;;
esac

LAUNCHER=()
if command -v uwsm-app >/dev/null 2>&1 && [[ -z "${UWSM_EXEC:-}" ]]; then
  LAUNCHER=(uwsm-app --)
fi

exec "${LAUNCHER[@]}" quickshell -p "$APP_QML" "$@"
