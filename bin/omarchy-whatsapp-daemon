#!/bin/bash

# omarchy:summary=Run the WhatsApp bridge daemon in the foreground
# omarchy:args=[--print-qr]

source "$(dirname "$(readlink -f "$0")")/_common.sh"

print_qr=0
for arg in "$@"; do
  case $arg in
  --print-qr) print_qr=1 ;;
  -h | --help)
    echo "Usage: omarchy-whatsapp-daemon [--print-qr]"
    echo
    echo "Runs in the foreground. Normally started by the user service:"
    echo "  systemctl --user start omarchy-whatsapp"
    exit 0
    ;;
  *) wa_die "unknown argument: $arg" ;;
  esac
done

wa_ensure_setup

if ((print_qr)); then
  export OMARCHY_WHATSAPP_PRINT_QR=1
fi

cd "$WA_DAEMON_DIR"
exec "$(wa_node)" index.js
